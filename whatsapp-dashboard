
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SQUIC LOANS WhatsApp Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#f4f7f6;color:#203044}
header{background:#087d4b;color:white;padding:20px}
header h1{margin:0}
nav{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
button{padding:12px 16px;border:0;border-radius:7px;cursor:pointer;font-weight:bold}
nav button,.send{background:#08a765;color:white}
main{max-width:1000px;margin:auto;padding:20px}
.card{background:white;padding:22px;margin:16px 0;border-radius:12px;box-shadow:0 2px 10px #0001}
input,textarea{width:100%;padding:12px;margin:8px 0;border:1px solid #ccd5d2;border-radius:7px;font:inherit}
textarea{min-height:100px}
.hidden{display:none}
.muted{color:#65756e;font-size:14px}
.status{white-space:pre-wrap;overflow-wrap:anywhere}
table{width:100%;border-collapse:collapse}
td,th{padding:10px;border-bottom:1px solid #ddd;text-align:left}
.tablewrap{overflow:auto}
</style>
</head>
<body>
<header>
  <h1>SQUIC LOANS</h1>
  <div>WhatsApp Business Dashboard</div>
  <nav>
    <button onclick="show('home')">Home</button>
    <button onclick="show('bulk')">Bulk Messages</button>
    <button onclick="show('inbox')">Incoming Inbox</button>
    <button onclick="show('reports')">Reports</button>
    <button onclick="logout()">Logout</button>
  </nav>
</header>

<main>
<section id="login" class="card">
  <h2>Staff Login</h2>
  <p class="muted">Use your existing SQUIC LOANS staff login.</p>
  <form id="loginForm">
    <label>Email</label>
    <input id="email" type="email" required>
    <label>Password</label>
    <input id="password" type="password" required>
    <button class="send">Login</button>
  </form>
  <p id="loginStatus" class="status"></p>
</section>

<div id="app" class="hidden">
<section id="home" class="page">
  <div class="card">
    <h2>Home Dashboard</h2>
    <p>Welcome to SQUIC LOANS WhatsApp API.</p>
    <p>Recipients loaded: <b id="total">0</b></p>
    <p>API accepted: <b id="sent">0</b></p>
    <p>Failed requests: <b id="failed">0</b></p>
    <p class="muted">API acceptance does not confirm delivery.</p>
  </div>
</section>

<section id="bulk" class="page hidden">
  <div class="card">
    <h2>Bulk Message Sender</h2>
    <p class="muted">Upload a CSV with a phone column, or enter one number per line. Include country code, e.g. 91XXXXXXXXXX.</p>
    <label>Upload customer CSV</label>
    <input type="file" id="csv" accept=".csv,text/csv">
    <label>Customer WhatsApp numbers</label>
    <textarea id="numbers" placeholder="919XXXXXXXXX&#10;919YYYYYYYYY"></textarea>
    <label>Message text</label>
    <textarea id="message" placeholder="Enter your message"></textarea>
    <p class="muted">Send only to customers who agreed to receive messages. For business-initiated messages outside the customer-service window, use Meta-approved templates. This basic screen sends text messages only.</p>
    <button onclick="preview()">Preview recipients</button>
    <button class="send" id="sendBtn" onclick="sendBulk()">Send Bulk Messages</button>
    <p id="bulkStatus" class="status"></p>
    <div class="tablewrap">
      <table>
        <thead><tr><th>Number</th><th>Result</th><th>Details</th></tr></thead>
        <tbody id="results"><tr><td colspan="3">No messages sent yet.</td></tr></tbody>
      </table>
    </div>
  </div>
</section>

<section id="inbox" class="page hidden">
  <div class="card">
    <h2>Incoming WhatsApp Inbox</h2>
    <p>Incoming messages are not connected yet.</p>
    <p class="muted">To receive customer messages here, we must configure a Meta webhook, verify token, and secure database tables in Supabase. This page does not receive messages by itself.</p>
  </div>
</section>

<section id="reports" class="page hidden">
  <div class="card">
    <h2>Session Reports</h2>
    <p class="muted">Results shown here are from this browser session. Delivery/read receipts require Meta status webhooks.</p>
    <div id="reportsList"></div>
  </div>
</section>
</div>
</main>

<script>
const SUPABASE_URL = "https://ceblgmgghzndwnenzvcd.supabase.co";
const SUPABASE_KEY = "sb_publishable_oxy3vbqzwte6U3a2WumvNA_kySOBPr6";
const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let results = [];

function show(id) {
  document.querySelectorAll(".page").forEach(x => x.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
}
function updateCounts() {
  document.getElementById("total").textContent = getNumbers().length;
  document.getElementById("sent").textContent = results.filter(x => x.ok).length;
  document.getElementById("failed").textContent = results.filter(x => !x.ok).length;
}
function getNumbers() {
  return [...new Set(document.getElementById("numbers").value
    .split(/[\n,;\r]+/)
    .map(x => x.trim().replace(/\D/g,""))
    .filter(x => x.length >= 10 && x.length <= 15))];
}
document.getElementById("csv").addEventListener("change", async e => {
  const file = e.target.files[0];
  if (!file) return;
  const lines = (await file.text()).split(/\r?\n/).filter(Boolean);
  if (!lines.length) return;
  const first = lines[0].split(",").map(x => x.trim().toLowerCase());
  let idx = first.findIndex(x => ["phone","mobile","number","whatsapp","phone number"].includes(x));
  const start = idx >= 0 ? 1 : 0;
  if (idx < 0) idx = 0;
  const imported = lines.slice(start).map(line =>
    (line.split(",")[idx] || "").replace(/\D/g,"")
  ).filter(x => x.length >= 10 && x.length <= 15);
  const combined = [...new Set([...getNumbers(), ...imported])];
  document.getElementById("numbers").value = combined.join("\n");
  updateCounts();
  document.getElementById("bulkStatus").textContent = imported.length + " valid numbers imported.";
});
function preview() {
  const nums = getNumbers();
  document.getElementById("results").innerHTML = nums.length
    ? nums.map(n => `<tr><td>${n}</td><td>Ready</td><td>Not sent</td></tr>`).join("")
    : '<tr><td colspan="3">No valid numbers. Add country code.</td></tr>';
  document.getElementById("bulkStatus").textContent = nums.length + " unique recipients found.";
  updateCounts();
}
async function sendBulk() {
  const nums = getNumbers();
  const msg = document.getElementById("message").value.trim();
  const status = document.getElementById("bulkStatus");
  const btn = document.getElementById("sendBtn");

  if (!nums.length) { status.textContent = "Enter valid phone numbers first."; return; }
  if (!msg) { status.textContent = "Enter a message first."; return; }
  if (!confirm("Send to " + nums.length + " opted-in customers?")) return;

  btn.disabled = true;
  const rows = [];
  for (let i = 0; i < nums.length; i++) {
    status.textContent = `Processing ${i+1} of ${nums.length}...`;
    try {
      const {data,error} = await db.functions.invoke("whatsapp-campaign", {
        body: {to: nums[i], message: msg}
      });
      if (error) throw new Error(error.message || "Request failed");
      const id = data?.messages?.[0]?.id;
      const ok = Boolean(id);
      results.push({phone:nums[i],ok,detail:id || JSON.stringify(data)});
      rows.push(`<tr><td>${nums[i]}</td><td>${ok?"API accepted":"Check response"}</td><td>${id || "See function response"}</td></tr>`);
    } catch (e) {
      results.push({phone:nums[i],ok:false,detail:e.message});
      rows.push(`<tr><td>${nums[i]}</td><td>Failed</td><td>${String(e.message).replace(/[<>&"]/g,"")}</td></tr>`);
    }
    document.getElementById("results").innerHTML = rows.join("");
    updateCounts();
  }
  document.getElementById("reportsList").innerHTML = results.slice().reverse()
    .map(r => `<p>${r.phone} — ${r.ok?"API accepted":"Failed"} — ${String(r.detail).replace(/[<>&"]/g,"")}</p>`).join("");
  status.textContent = "Finished. API accepted does not mean delivered; delivery status requires webhook setup.";
  btn.disabled = false;
}
async function logout() {
  await db.auth.signOut();
  document.getElementById("app").classList.add("hidden");
  document.getElementById("login").classList.remove("hidden");
}
document.getElementById("loginForm").addEventListener("submit", async e => {
  e.preventDefault();
  document.getElementById("loginStatus").textContent = "Signing in...";
  const {error} = await db.auth.signInWithPassword({
    email: document.getElementById("email").value.trim(),
    password: document.getElementById("password").value
  });
  if (error) {
    document.getElementById("loginStatus").textContent = error.message;
    return;
  }
  document.getElementById("login").classList.add("hidden");
  document.getElementById("app").classList.remove("hidden");
  show("home");
});
(async function init() {
  const {data} = await db.auth.getSession();
  if (data.session) {
    document.getElementById("login").classList.add("hidden");
    document.getElementById("app").classList.remove("hidden");
  }
})();
</script>
</body>
</html>

